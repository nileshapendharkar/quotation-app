# Server Configuration
PORT=5000

# Authentication
JWT_SECRET=ganesh_gouri_quotation_jwt_secret_key_2026

# MongoDB Database Configuration
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/quotation_app?retryWrites=true&w=majority
# For Local MongoDB: mongodb://127.0.0.1:27017/quotation_app
MONGODB_URI=
MONGODB_DB_NAME=quotation_app
MONGODB_COLLECTION=quotation_state

# MSG91 OTP SMS (login OTP for the mobile app)
# Authkey: MSG91 panel > Authkey.  Template ID: MSG91 panel > OTP > Templates (template must contain ##OTP##)
# If either value is empty, the backend does NOT send an SMS (it only simulates OTP delivery).
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
